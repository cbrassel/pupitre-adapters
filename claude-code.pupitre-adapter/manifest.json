{
  "id": "claude-code",
  "name": "Claude Code",
  "version": "1.5.0",
  "adapterApi": 1,
  "cli": { "binary": "claude", "versionCommand": ["--version"], "testedVersions": ">=2.1.295 <2.2.0",
           "parentSessionEnvironment": ["CLAUDECODE", "CLAUDE_CODE_CHILD_SESSION", "CLAUDE_CODE_SESSION_ID",
                                        "CLAUDE_CODE_ENTRYPOINT", "CLAUDE_CODE_SESSION_ATTENDED",
                                        "CLAUDE_CODE_MESSAGING_SOCKET", "CLAUDE_CODE_MESSAGING_TOKEN",
                                        "CLAUDE_CODE_EXECPATH", "CLAUDE_PID"] },
  "launch": {
    "new":    ["claude", "--session-id", "{sessionId}"],
    "resume": ["claude", "--resume", "{sessionId}"]
  },
  "paths": {
    "root": "~/.claude/projects",
    "sessionGlob": "*/{sessionId}.jsonl",
    "subagentsDir": "{sessionDir}/{sessionId}/subagents"
  },
  "input": { "exit": "/exit" },
  "hooks": {
    "format": "hooks-json-1",
    "settingsFlag": "--settings",
    "events": ["SessionStart", "UserPromptSubmit", "Stop", "SubagentStop", "Notification"]
  },
  "controls": {
    "model": { "command": "/model {value}", "options": [
      { "value": "default", "label": "Par défaut" },
      { "value": "opus", "label": "Opus" },
      { "value": "opus[1m]", "label": "Opus (contexte 1 M)" },
      { "value": "sonnet", "label": "Sonnet" },
      { "value": "sonnet[1m]", "label": "Sonnet (contexte 1 M)" },
      { "value": "haiku", "label": "Haiku" }
    ] },
    "effort": { "command": "/effort {value}", "options": [
      { "value": "low", "label": "Faible" },
      { "value": "medium", "label": "Moyen" },
      { "value": "high", "label": "Élevé" },
      { "value": "xhigh", "label": "Très élevé" },
      { "value": "max", "label": "Maximal" },
      { "value": "auto", "label": "Auto (selon le modèle)" }
    ] }
  },
  "statusLine": {
    "settingsKey": "statusLine",
    "userSettings": ["{cwd}/.claude/settings.local.json", "{cwd}/.claude/settings.json", "~/.claude/settings.json"]
  },
  "contextWindowSizes": [200000, 1000000],
  "capabilities": { "subagents": true, "resume": true, "hooks": true, "statusLine": true }
}
